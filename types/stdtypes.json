        { "name": "Rtsp", "value": 0, "unit": "", "note": "" },
        { "name": "WebrtcWhep", "value": 1, "unit": "", "note": "WebRTC set up over WHEP" },
        { "name": "Hls", "value": 2, "unit": "", "note": "" },
        { "name": "Srt", "value": 3, "unit": "", "note": "" },
        { "name": "Rtp", "value": 4, "unit": "", "note": "" },
        { "name": "HttpMjpeg", "value": 5, "unit": "", "note": "MJPEG over HTTP" },
        { "name": "Other", "value": 15, "unit": "", "note": "" }
      ] },
    { "name": "ExternalVideoStream", "kind": "struct", "fixed": true, "size": 302,
      "about": ["Where to watch a video stream, so a viewer connects to it directly"],
      "members": [
        { "name": "kind", "type": "VideoStreamKind", "unit": "", "note": "the protocol of url" },
        { "name": "codec", "type": "VideoCodec", "unit": "", "note": "a hint, Unknown when unstated" },
        { "name": "width", "type": "u32", "unit": "px", "note": "a hint, 0 when unstated" },
        { "name": "height", "type": "u32", "unit": "px", "note": "a hint, 0 when unstated" },
        { "name": "url", "type": "Uri", "unit": "", "note": "the stream address" },
        { "name": "name", "type": "string<32>", "unit": "", "note": "a label for the stream" }
      ] },
    { "name": "DistortionModel", "kind": "enum", "backing": "u8", "fixed": true, "size": 1,
      "about": ["A lens distortion model"],
      "members": [
        { "name": "None", "value": 0, "unit": "", "note": "an ideal pinhole" },
        { "name": "BrownConrady", "value": 1, "unit": "", "note": "" },
        { "name": "Fisheye", "value": 2, "unit": "", "note": "" },
        { "name": "Rational", "value": 3, "unit": "", "note": "" }
      ] },
    { "name": "CameraIntrinsics", "kind": "struct", "fixed": true, "size": 105,
      "about": ["The pinhole model of a camera and its lens distortion"],
      "members": [
        { "name": "width", "type": "u32", "unit": "px", "note": "the resolution these values hold for" },
        { "name": "height", "type": "u32", "unit": "px", "note": "" },
        { "name": "fx", "type": "f64", "unit": "px", "note": "focal length along x" },
        { "name": "fy", "type": "f64", "unit": "px", "note": "focal length along y" },
        { "name": "cx", "type": "f64", "unit": "px", "note": "principal point x" },
        { "name": "cy", "type": "f64", "unit": "px", "note": "principal point y" },
        { "name": "model", "type": "DistortionModel", "unit": "", "note": "the lens distortion model" },
        { "name": "coeffs", "type": "f64[8]", "unit": "", "note": "OpenCV's order: k1 k2 p1 p2 k3, then k4 k5 k6 for Rational, or k1 to k4 for Fisheye, 0 past that" }
      ] },
    { "name": "JointState", "kind": "struct", "fixed": false, "size": 0,
      "about": ["The joints of a robot, in the order of its JointNames"],
      "members": [
        { "name": "position", "type": "f64[]", "unit": "rad or m", "note": "rad for a turning joint, m for a sliding one" },
        { "name": "velocity", "type": "f64[]", "unit": "rad/s or m/s", "note": "may be empty" },
        { "name": "effort", "type": "f64[]", "unit": "N m or N", "note": "may be empty" }
      ] },
    { "name": "JointNames", "kind": "struct", "fixed": false, "size": 0,
      "about": ["The joint names a JointState follows, published once"],
      "members": [
        { "name": "name", "type": "string[]", "unit": "", "note": "" }
      ] },
    { "name": "JointTrajectoryPoint", "kind": "struct", "fixed": false, "size": 8,
      "about": ["Where the joints should be at one time, in the order of their JointNames"],
      "members": [
        { "name": "time", "type": "Duration", "unit": "us", "note": "from the start of the trajectory" },
        { "name": "position", "type": "f64[]", "unit": "rad or m", "note": "" },
        { "name": "velocity", "type": "f64[]", "unit": "rad/s or m/s", "note": "may be empty" },
        { "name": "acceleration", "type": "f64[]", "unit": "rad/s^2 or m/s^2", "note": "may be empty" },
        { "name": "effort", "type": "f64[]", "unit": "N m or N", "note": "may be empty" }
      ] },
    { "name": "JointTrajectory", "kind": "struct", "fixed": false, "size": 0,
      "about": ["A motion of the joints over time"],
      "members": [
        { "name": "points", "type": "JointTrajectoryPoint[]", "unit": "", "note": "in time order" }
      ] },
    { "name": "Imu", "kind": "struct", "fixed": true, "size": 296,
      "about": ["One reading of an inertial measurement unit, in its own frame", "A covariance with -1 first means that value is not measured"],
      "members": [
        { "name": "orientation", "type": "Quaternion", "unit": "", "note": "" },
        { "name": "orientation_covariance", "type": "Covariance3", "unit": "rad^2", "note": "about x, y and z" },
        { "name": "angular_velocity", "type": "Double3", "unit": "rad/s", "note": "about each axis" },
        { "name": "angular_velocity_covariance", "type": "Covariance3", "unit": "rad^2/s^2", "note": "" },
        { "name": "linear_acceleration", "type": "Double3", "unit": "m/s^2", "note": "gravity included" },
        { "name": "linear_acceleration_covariance", "type": "Covariance3", "unit": "m^2/s^4", "note": "" }
      ] },
    { "name": "LaserScan", "kind": "struct", "fixed": false, "size": 21,
      "about": ["One sweep of a planar range sensor, its beams turning from +x toward +y"],
      "members": [
        { "name": "angle_min", "type": "f32", "unit": "rad", "note": "the first beam" },
        { "name": "angle_step", "type": "f32", "unit": "rad", "note": "from one beam to the next" },
        { "name": "time_step", "type": "f32", "unit": "s", "note": "from one beam to the next, 0 when unstated" },
        { "name": "range_min", "type": "f32", "unit": "m", "note": "a shorter range is not valid" },
        { "name": "range_max", "type": "f32", "unit": "m", "note": "a longer range is not valid" },
        { "name": "echoes", "type": "u8", "unit": "", "note": "the ranges per beam, 0 reads as 1" },
        { "name": "ranges", "type": "f32[]", "unit": "m", "note": "each beam's echoes together, +inf when nothing returns" },
        { "name": "intensities", "type": "f32[]", "unit": "", "note": "in the order of ranges, may be empty" }
      ] },
    { "name": "RangeKind", "kind": "enum", "backing": "u8", "fixed": true, "size": 1,
      "about": ["What a range sensor measures with"],
      "members": [
        { "name": "Unknown", "value": 0, "unit": "", "note": "unstated" },
        { "name": "Ultrasound", "value": 1, "unit": "", "note": "" },
        { "name": "Infrared", "value": 2, "unit": "", "note": "" },
        { "name": "Laser", "value": 3, "unit": "", "note": "" },
        { "name": "Radar", "value": 4, "unit": "", "note": "" }
      ] },
    { "name": "RangeReading", "kind": "struct", "fixed": true, "size": 33,
      "about": ["One distance from a sensor with a single beam or cone along its +x"],
      "members": [
        { "name": "distance", "type": "f64", "unit": "m", "note": "+inf when nothing is in range" },
        { "name": "min", "type": "f64", "unit": "m", "note": "the shortest distance it reads" },
        { "name": "max", "type": "f64", "unit": "m", "note": "the longest distance it reads" },
        { "name": "field_of_view", "type": "f64", "unit": "rad", "note": "the full angle of the cone" },
        { "name": "kind", "type": "RangeKind", "unit": "", "note": "" }
      ] },
    { "name": "GnssStatus", "kind": "enum", "backing": "u8", "fixed": true, "size": 1,
      "about": ["The quality of a satellite position fix"],
      "members": [
        { "name": "NoFix", "value": 0, "unit": "", "note": "the position is not valid" },
        { "name": "Fix", "value": 1, "unit": "", "note": "satellites alone" },
        { "name": "Differential", "value": 2, "unit": "", "note": "corrected by SBAS or DGPS" },
        { "name": "RtkFloat", "value": 3, "unit": "", "note": "RTK, ambiguities not yet resolved" },
        { "name": "RtkFixed", "value": 4, "unit": "", "note": "RTK, centimeter level" }
      ] },
    { "name": "GnssFix", "kind": "struct", "fixed": true, "size": 97,
      "about": ["A position from satellite navigation"],
      "members": [
        { "name": "position", "type": "GeoPoint", "unit": "", "note": "" },
        { "name": "covariance", "type": "Covariance3", "unit": "m^2", "note": "east, north and up" },
        { "name": "status", "type": "GnssStatus", "unit": "", "note": "" }
      ] },
    { "name": "ScalarKind", "kind": "enum", "backing": "u8", "fixed": true, "size": 1,
      "about": ["The kind of number in a block of raw data, numbered as in PCL"],
      "members": [
        { "name": "I8", "value": 1, "unit": "", "note": "" },
        { "name": "U8", "value": 2, "unit": "", "note": "" },
        { "name": "I16", "value": 3, "unit": "", "note": "" },
        { "name": "U16", "value": 4, "unit": "", "note": "" },
        { "name": "I32", "value": 5, "unit": "", "note": "" },
        { "name": "U32", "value": 6, "unit": "", "note": "" },
        { "name": "F32", "value": 7, "unit": "", "note": "" },
        { "name": "F64", "value": 8, "unit": "", "note": "" },
        { "name": "I64", "value": 9, "unit": "", "note": "" },
        { "name": "U64", "value": 10, "unit": "", "note": "" }
      ] },
    { "name": "PointField", "kind": "struct", "fixed": false, "size": 9,
      "about": ["One value that every point of a PointCloud holds"],
      "members": [
        { "name": "name", "type": "string", "unit": "", "note": "such as x, y, z, intensity or rgb" },
        { "name": "offset", "type": "u32", "unit": "bytes", "note": "from the start of the point" },
        { "name": "kind", "type": "ScalarKind", "unit": "", "note": "" },
        { "name": "count", "type": "u32", "unit": "", "note": "the numbers in a row, 1 for a single number" }
      ] },
    { "name": "PointCloud", "kind": "struct", "fixed": false, "size": 97,
      "about": ["Points with any values each, packed one point after another as in PCL"],
      "members": [
        { "name": "origin", "type": "Transform", "unit": "", "note": "the frame the points are in" },
        { "name": "width", "type": "u32", "unit": "", "note": "points per row when the cloud is an image, 0 when it has no rows" },
        { "name": "fields", "type": "PointField[]", "unit": "", "note": "what each point holds" },
        { "name": "point_step", "type": "u32", "unit": "bytes", "note": "from one point to the next" },
        { "name": "dense", "type": "bool", "unit": "", "note": "no point holds an invalid value" },
        { "name": "data", "type": "u8[]", "unit": "", "note": "the points, little endian" }
      ] },
    { "name": "Mesh", "kind": "struct", "fixed": false, "size": 97,
      "about": ["A surface of triangles"],
      "members": [
        { "name": "vertices", "type": "PointCloud", "unit": "", "note": "the corners, with x, y and z among their fields" },
        { "name": "triangles", "type": "u32[]", "unit": "", "note": "three vertex indices each, counterclockwise seen from outside" }
      ] },
    { "name": "GridField", "kind": "struct", "fixed": false, "size": 1,
      "about": ["One value that every cell of a Grid holds"],
      "members": [
        { "name": "name", "type": "string", "unit": "", "note": "such as occupancy, height or cost" },
        { "name": "kind", "type": "ScalarKind", "unit": "", "note": "" },
        { "name": "data", "type": "u8[]", "unit": "", "note": "one number per cell, x fastest, then y, then z, little endian" }
      ] },
    { "name": "Grid", "kind": "struct", "fixed": false, "size": 108,
      "about": ["A 2D or 3D grid of cells with any values each, such as a map"],
      "members": [
        { "name": "origin", "type": "Transform", "unit": "", "note": "the frame, and the pose of the outer corner of cell 0" },
        { "name": "resolution", "type": "f64", "unit": "m", "note": "the edge of a cell" },
        { "name": "cells_x", "type": "u32", "unit": "", "note": "cells along x" },
        { "name": "cells_y", "type": "u32", "unit": "", "note": "cells along y" },
        { "name": "cells_z", "type": "u32", "unit": "", "note": "cells along z, 1 for a 2D grid" },
        { "name": "fields", "type": "GridField[]", "unit": "", "note": "what each cell holds" }
      ] },
    { "name": "Tensor", "kind": "struct", "fixed": false, "size": 1,
      "about": ["An array of numbers with any number of dimensions"],
      "members": [
        { "name": "kind", "type": "ScalarKind", "unit": "", "note": "" },
        { "name": "shape", "type": "u32[]", "unit": "", "note": "the size of each dimension, outermost first" },
        { "name": "data", "type": "u8[]", "unit": "", "note": "the numbers, last dimension fastest, little endian" }
      ] },
    { "name": "File", "kind": "struct", "fixed": false, "size": 66,
      "about": ["A whole file"],
      "members": [
        { "name": "name", "type": "string", "unit": "", "note": "the file name with its extension" },
        { "name": "media_type", "type": "string<64>", "unit": "", "note": "such as image/png, empty when unknown" },
        { "name": "data", "type": "u8[]", "unit": "", "note": "the file bytes" }
      ] },
    { "name": "Detection2D", "kind": "struct", "fixed": false, "size": 48,
      "about": ["An object found in an image or a 2D frame"],
      "members": [
        { "name": "bounds", "type": "OrientedBox2D", "unit": "", "note": "where it is" },
        { "name": "label", "type": "string", "unit": "", "note": "what it is" },
        { "name": "score", "type": "f32", "unit": "", "note": "the confidence, 0 to 1" },
        { "name": "track", "type": "u32", "unit": "", "note": "the same id in every frame, 0 when not tracked" }
      ] },
    { "name": "Detection3D", "kind": "struct", "fixed": false, "size": 88,
      "about": ["An object found in a 3D frame"],
      "members": [
        { "name": "bounds", "type": "OrientedBox", "unit": "", "note": "where it is" },
        { "name": "label", "type": "string", "unit": "", "note": "what it is" },
        { "name": "score", "type": "f32", "unit": "", "note": "the confidence, 0 to 1" },
        { "name": "track", "type": "u32", "unit": "", "note": "the same id in every frame, 0 when not tracked" }
      ] }
  ]
}
