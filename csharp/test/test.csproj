<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles the wrapper (../Dart.cs) and copies the prebuilt native lib next to the
       exe so [DllImport("dart")] resolves. Build the native lib first: csharp/native/build.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>dart_test</AssemblyName>
    <RootNamespace>DartTest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Dart.cs" />
    <None Include="../runtimes/**/native/*" Link="%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
