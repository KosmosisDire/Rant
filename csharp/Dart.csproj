<Project Sdk="Microsoft.NET.Sdk">

  <!-- The NuGet package: the P/Invoke wrapper plus the native library per platform under
       runtimes/<rid>/native/, so .NET loads the right one. The CMake target dart_shared
       builds the library into dist/native/<rid>/, then: dotnet pack csharp/Dart.csproj -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Dart</AssemblyName>
    <RootNamespace>Dart</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <PackageId>Dart</PackageId>
    <Version>0.1.0</Version>
    <Description>DART (Discovery And Realtime Transport): peer discovery over UDP multicast plus reliable realtime UDP pub/sub, with typed (schema) messages. Thin P/Invoke wrapper over a prebuilt native library (win-x64, linux-x64).</Description>
    <PackageTags>networking;pubsub;udp;discovery;realtime;middleware;dart;rant</PackageTags>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Dart.cs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Globbed, so a platform that was not built is left out rather than failing the pack. -->
  <ItemGroup>
    <None Include="../dist/native/**" Pack="true" PackagePath="runtimes/%(RecursiveDir)native/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
