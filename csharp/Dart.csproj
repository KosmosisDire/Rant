<Project Sdk="Microsoft.NET.Sdk">

  <!-- DART C# NuGet package: the thin P/Invoke wrapper (Dart.cs) plus the prebuilt native
       library, bundled under runtimes/<rid>/native/ so .NET loads the right one per platform.
       Build the native libs first (csharp/native/build.ps1 on Windows, build.sh on Linux),
       then:  dotnet pack csharp/Dart.csproj -c Release -o nupkg
       The binaries are gitignored; CI (or the build scripts) produce them before packing. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Dart</AssemblyName>
    <RootNamespace>Dart</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <PackageId>Dart.Middleware</PackageId>
    <Version>0.1.0</Version>
    <Description>DART (Discovery And Realtime Transport): peer discovery over UDP multicast plus reliable realtime UDP pub/sub, with typed (schema) messages. Thin P/Invoke wrapper over a prebuilt native library (win-x64, linux-x64).</Description>
    <PackageTags>networking;pubsub;udp;discovery;realtime;middleware;dart;rant</PackageTags>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Dart.cs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Prebuilt native libraries -> runtimes/<rid>/native/ in the package, and copied next
       to the consumer's output so [DllImport("dart")] resolves. Globbed so a missing platform
       (not yet built) simply isn't packed rather than breaking the build. -->
  <ItemGroup>
    <None Include="runtimes/**/native/*" Pack="true" PackagePath="runtimes/">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
