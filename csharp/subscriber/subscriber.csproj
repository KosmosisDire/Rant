<Project Sdk="Microsoft.NET.Sdk">

  <!-- Subscribes to 'tick' and reports the received message rate (Hz). Pair with
       csharp/publisher (or python/publisher.py) to see end-to-end throughput. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>dart_subscriber</AssemblyName>
    <RootNamespace>DartSubscriber</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Dart.cs" />
    <None Include="../runtimes/**/native/*" Link="%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
