<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles the wrapper (../Rant.cs) and copies the native library next to the exe so
       [DllImport("rant")] resolves. Build it first: the CMake target rant_shared. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>rant_test</AssemblyName>
    <RootNamespace>RantTest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Rant.cs" />
    <None Include="../../../dist/native/**/*" Link="%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
