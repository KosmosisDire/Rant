<Project Sdk="Microsoft.NET.Sdk">

  <!-- Subscribes to 'tick' and reports the received message rate (Hz). Pair with
       bindings/csharp/publisher (or bindings/python/publisher.py) to see end-to-end throughput. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>rant_subscriber</AssemblyName>
    <RootNamespace>RantSubscriber</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Rant.cs" />
    <None Include="../../../dist/native/**/*" Link="%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
