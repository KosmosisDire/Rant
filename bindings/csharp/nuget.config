<?xml version="1.0" encoding="utf-8"?>
<!-- The examples consume the packed Rant package from dist/, so they see the wrapper the
     way a package user does. Pack it first: dotnet pack bindings/csharp/Rant.csproj -c Release -o dist -->
<configuration>
  <packageSources>
    <add key="rant-dist" value="../../dist" />
  </packageSources>
</configuration>
