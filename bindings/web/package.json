{
    "name": "rant-middleware",
    "version": "0.0.41",
    "description": "Rant for TypeScript, real Rant built to wasm, in a page or in Node.js, and its net objects and C side",
    "license": "SEE LICENSE IN LICENCE.md",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/rant.d.ts",
            "default": "./dist/rant.js"
        },
        "./net": {
            "types": "./dist/net.d.ts",
            "default": "./dist/net.js"
        },
        "./udp": {
            "types": "./dist/udp.d.ts",
            "default": "./dist/udp.js"
        },
        "./tunnel": {
            "types": "./dist/tunnel.d.ts",
            "default": "./dist/tunnel.js"
        }
    },
    "files": ["dist", "c", "LICENCE.md"],
    "scripts": {
        "build": "tsc -p .",
        "check": "tsc -p . --noEmit"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.9.0"
    }
}
