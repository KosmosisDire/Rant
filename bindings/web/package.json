{
    "name": "rant-middleware",
    "version": "0.0.27",
    "description": "Rant in a page or in Node.js: the net objects of Rant built to wasm, and its C side",
    "license": "SEE LICENSE IN LICENCE.md",
    "type": "module",
    "exports": {
        "./net": { "types": "./dist/net.d.ts", "default": "./dist/net.js" },
        "./udp": { "types": "./dist/udp.d.ts", "default": "./dist/udp.js" },
        "./tunnel": { "types": "./dist/tunnel.d.ts", "default": "./dist/tunnel.js" }
    },
    "files": ["dist", "c", "LICENCE.md"],
    "scripts": {
        "build": "tsc -p .",
        "check": "tsc -p . --noEmit"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.9.0"
    }
}
